{
    "name": "alebrije",
    "version": "0.6.0",
    "description": "Headless low-poly avatars for three.js: skinned humanoid, walk and idle clips, glTF export, MapLibre and GeoServer.",
    "keywords": [
        "threejs",
        "avatar",
        "low-poly",
        "humanoid",
        "skeleton",
        "animation",
        "gltf",
        "headless",
        "maplibre",
        "3d"
    ],
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/alebrije.git"
    },
    "author": "Edgar Villarreal",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./geo": {
            "types": "./dist/geo/index.d.ts",
            "import": "./dist/geo/index.js"
        },
        "./geoserver": {
            "types": "./dist/geoserver/index.d.ts",
            "import": "./dist/geoserver/index.js"
        },
        "./maplibre": {
            "types": "./dist/maplibre/index.d.ts",
            "import": "./dist/maplibre/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts"
    },
    "dependencies": {
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "react": ">=19",
        "three": ">=0.186"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@npmegar/eslint-config": "^0.4.0",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "happy-dom": "^20.14.6",
        "maplibre-gl": "^6.10.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rotulo": "^0.3.0",
        "three": "^0.186.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
